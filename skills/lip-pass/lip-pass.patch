diff --git a/src/utils/face_yunet.py b/src/utils/face_yunet.py
new file mode 100644
index 0000000..e1749de
--- /dev/null
+++ b/src/utils/face_yunet.py
@@ -0,0 +1,42 @@
+# coding: utf-8
+"""YuNet (OpenCV zoo, MIT) in place of InsightFace's detector (non-commercial models): the face box and its 5 points
+(eyes, nose, mouth corners) seed LivePortrait's own 203-point landmark model, which accepts 5 points (crop.parse_pt2_from_pt5)."""
+import os
+import cv2
+import numpy as np
+
+YUNET = os.environ.get('LP_YUNET', os.path.join(os.path.dirname(__file__), '../../pretrained_weights/yunet/face_detection_yunet_2023mar.onnx'))
+
+
+class Face(dict):  # dict with attribute access, as InsightFace's Face
+    __getattr__ = dict.get
+
+
+class YuNetFaces:
+    def __init__(self, det_thresh=0.5):
+        self.det = cv2.FaceDetectorYN.create(YUNET, '', (320, 320), det_thresh, 0.3, 5000)
+
+    def get(self, img_bgr, direction='large-small', max_face_num=0, **kwargs):
+        h, w = img_bgr.shape[:2]
+        self.det.setInputSize((w, h))
+        _, found = self.det.detect(img_bgr)
+        faces = []
+        for f in (found if found is not None else []):
+            x, y, bw, bh = f[:4]
+            faces.append(Face({'bbox': np.array([x, y, x + bw, y + bh], np.float32),
+                          'landmark_2d_106': f[4:14].reshape(5, 2).astype(np.float32),  # name kept for the cropper
+                          'det_score': float(f[14])}))
+        area = lambda d: (d['bbox'][2] - d['bbox'][0]) * (d['bbox'][3] - d['bbox'][1])
+        faces.sort(key=area, reverse=direction != 'small-large')
+        return faces[:max_face_num] if max_face_num else faces
+
+    def warmup(self):
+        self.get(np.zeros((512, 512, 3), np.uint8))
+
+
+if __name__ == '__main__':  # self-check: finds one face with 5 points in a test portrait
+    import sys
+    img = cv2.imread(sys.argv[1])
+    got = YuNetFaces().get(img)
+    assert got and got[0]['landmark_2d_106'].shape == (5, 2), got
+    print('ok', got[0]['bbox'], got[0]['det_score'])
