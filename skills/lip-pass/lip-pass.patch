+"""One shot's lip pass for HyperFrames Desktop's re-perform, then its numbers.
+
+The generated shot (--source) gets its lips from the original performer's (--driving): lip region only, lips closed
+first, motion measured from the driving's most-closed frame and scaled by --gain. Then each of driving, source and the
+output is measured frame by frame (MediaPipe face mesh: inner-lip gap over face height; LivePortrait's own lip ratio
+agreed with it only r 0.22 on a real performer, too loose to gate on), and the output's mean absolute
+difference from the source frames is taken, so the caller can refuse a shot whose lip pass warped the face.
+
+  python lip_pass.py --source gen.mp4 --driving src.mp4 --out out.mp4 --metrics m.json [--gain 1.6] [--yunet f.onnx]
+  python lip_pass.py --self-check
+"""
+import argparse, json, os, subprocess, sys
+import numpy as np
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+
+
+def frames(path):
+    import cv2
+    cap, out = cv2.VideoCapture(path), []
+    while True:
+        ok, f = cap.read()
+        if not ok:
+            return out
+        out.append(f)
+
+
+def lip_open(bgr, sharp=False):
+    """Per frame inner-lip gap over face height (None where no face); with sharp, also the mouth's median detail
+    (Laplacian variance of the lips' box): LivePortrait blurs some mouths, which the gap alone can't see."""
+    import math, cv2, mediapipe as mp
+    lips = sorted({i for e in mp.solutions.face_mesh.FACEMESH_LIPS for i in e})
+    mesh, out, detail = mp.solutions.face_mesh.FaceMesh(static_image_mode=False, max_num_faces=1), [], []
+    for k, f in enumerate(bgr):
+        r = mesh.process(np.ascontiguousarray(f[..., ::-1]))
+        if not r.multi_face_landmarks:
+            out.append(None)
+            continue
+        p = r.multi_face_landmarks[0].landmark
+        out.append(math.hypot(p[13].x - p[14].x, p[13].y - p[14].y) / max(1e-6, math.hypot(p[10].x - p[152].x, p[10].y - p[152].y)))
+        if sharp and k % 4 == 0:
+            h, w = f.shape[:2]; xs = [p[i].x * w for i in lips]; ys = [p[i].y * h for i in lips]; fh = abs(p[152].y - p[10].y) * h
+            box = f[max(0, int(min(ys) - .1 * fh)):int(max(ys) + .1 * fh), max(0, int(min(xs) - .1 * fh)):int(max(xs) + .1 * fh)]
+            if box.size: detail.append(cv2.Laplacian(cv2.resize(cv2.cvtColor(box, cv2.COLOR_BGR2GRAY), (96, 48)), cv2.CV_64F).var())
+    return (out, float(np.median(detail)) if detail else None) if sharp else out
+
+
+def frame_diff(a, b):
+    import cv2
+    n = min(len(a), len(b))
+    small = lambda f: cv2.resize(f, (192, int(192 * f.shape[0] / f.shape[1]))).astype(np.int16)
+    return float(np.mean([np.abs(small(a[i]) - small(b[i])).mean() for i in range(n)])) if n else 0.0
+
+
+def render(args):
+    env = {**os.environ, 'LP_LIP_REF': 'closed', 'LP_LIP_GAIN': str(args.gain), 'PYTORCH_ENABLE_MPS_FALLBACK': '1'}
+    if args.yunet:
+        env['LP_YUNET'] = args.yunet
+    work = args.out + '.work'
+    subprocess.run([sys.executable, os.path.join(HERE, 'inference.py'), '-s', args.source, '-d', args.driving, '-o', work,
+                    '--animation_region', 'lip', '--flag_normalize_lip', '--flag_crop_driving_video', '--source_max_dim', '1344'],
+                   cwd=HERE, env=env, check=True)
+    name = f"{os.path.splitext(os.path.basename(args.source))[0]}--{os.path.splitext(os.path.basename(args.driving))[0]}.mp4"
+    os.replace(os.path.join(work, name), args.out)
+    subprocess.run(['rm', '-rf', work])
+
+
+def measure(args):
+    d, s, o = frames(args.driving), frames(args.source), frames(args.out)
+    (so, ss), (oo, os_) = lip_open(s, sharp=True), lip_open(o, sharp=True)
+    return {'gain': args.gain, 'open': {'driving': lip_open(d), 'source': so, 'output': oo},
+            'diff': frame_diff(o, s), 'sharp': {'source': ss, 'output': os_}}
+
+
+def self_check():
+    a = [np.zeros((64, 64, 3), np.uint8)] * 3
+    b = [np.full((64, 64, 3), 10, np.uint8)] * 3
+    assert frame_diff(a, a) == 0.0 and abs(frame_diff(a, b) - 10) < 1e-6 and frame_diff(a, []) == 0.0
+    print('lip_pass self-check ok')
+
+
+def main():
+    p = argparse.ArgumentParser()
+    for k in ('--source', '--driving', '--out', '--metrics', '--yunet'):
+        p.add_argument(k)
+    p.add_argument('--gain', type=float, default=1.6)
+    p.add_argument('--self-check', action='store_true')
+    args = p.parse_args()
+    if args.self_check:
+        return self_check()
+    sys.path.insert(0, HERE)
+    os.chdir(HERE)
+    if not os.path.exists(args.out):  # an output already made is measured again, not re-rendered
+        render(args)
+    json.dump(measure(args), open(args.metrics, 'w'))
+
+
+if __name__ == '__main__':
+    main()
